{
  "expo": {
    "name": "x2 Remote",
    "slug": "x2Remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#202020"
    },
    "scheme": "x2remote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddaniel0711.x2Remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app discovers TVs and accessories on your Wi‑Fi for smart remote control.",
        "NSBonjourServices": [
          "_roku._tcp",
          "_googlecast._tcp",
          "_androidtvremote2._tcp",
          "_airplay._tcp",
          "_hap._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#202020"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "package": "com.ddaniel0711.x2Remote",
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIRModule",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#202020",
          "dark": {
            "backgroundColor": "#202020"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18d64b50-d0df-45df-a82e-79e613daa416"
      }
    },
    "owner": "touseef_amjad"
  }
}
